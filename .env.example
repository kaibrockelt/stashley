# Required. At least 32 bytes, e.g. the output of: openssl rand -base64 32
APP_SECRET_KEY=
# Required. Public URL of this instance (https, except for localhost).
APP_BASE_URL=http://localhost:8080

# First admin account, read only while no admin exists.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Optional. Without SMTP, invitation and reset links are shown to admins for copying.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional. Addresses or CIDRs of reverse proxies allowed to set X-Forwarded-* headers.
TRUST_PROXY=
# Optional. Query cache limit in MB (default 256).
CACHE_MAX_MB=256
# Optional. debug, info, warn or error.
LOG_LEVEL=info
# Optional. IANA time zone for display and date expressions (default UTC).
APP_TIMEZONE=UTC
# Optional. "off" leaves the public REST API (/api) unregistered (default on).
STASHLEY_PUBLIC_API=on
# Optional. CSV import limits: running imports per instance and per user, upload size in MB,
# rows per batch (defaults 2, 1, 50, 500).
STASHLEY_IMPORT_CONCURRENCY=2
STASHLEY_IMPORT_PER_USER=1
STASHLEY_IMPORT_MAX_MB=50
STASHLEY_IMPORT_BATCH_SIZE=500

# Secrets can also be read from files, e.g. Docker secrets:
# APP_SECRET_KEY_FILE=/run/secrets/stashley_secret_key

# Optional. Host port for docker compose (default 8080).
STASHLEY_PORT=8080
