{
  "name": "stashley",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "tsc -b && tsc -p apps/server/tsconfig.test.json && tsc -p packages/shared/tsconfig.test.json && pnpm --filter @stashley/web typecheck",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "pnpm -r test",
    "check:spdx": "node scripts/check-spdx.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:i18n": "pnpm --filter @stashley/web check:i18n",
    "check:bundle": "pnpm --filter @stashley/web check:bundle",
    "check": "pnpm typecheck && pnpm lint && pnpm check:spdx && pnpm check:i18n && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.10.2",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
